# Copie este arquivo para .env e preencha com os valores reais.
# O arquivo .env está no .gitignore e NUNCA deve ser versionado.

# --- Credenciais do OAuth client ID (Google Cloud Console > APIs e serviços > Credenciais) ---
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=troque-pelo-client-secret

# Redirect URI cadastrada no Google — precisa ser IDÊNTICA (comparação exata de string)
REDIRECT_URI=https://localhost:8443/callback

# Documento de descoberta do provedor OIDC
OIDC_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration

# Usuário inexistente na tabela local:
#   true  -> cria o registro com role=user, apenas com dados validados e email_verified=true
#   false -> recusa o login (conta precisa ser pré-cadastrada com scripts/gerenciar_usuarios.py)
AUTO_PROVISION=true

# Lista de "sub" (separados por vírgula) que recebem role=admin ao serem criados
ADMIN_SUBS=

# Opcional (ponto extra): restringe o acesso a um domínio Google Workspace usando o claim "hd"
# Ex.: ALLOWED_HD=unoesc.edu.br   (deixe vazio para aceitar qualquer conta)
ALLOWED_HD=

# Tolerância de relógio (segundos) para exp/iat — "poucos minutos"
CLOCK_SKEW_SECONDS=120

# Sessão local
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=8

# Máximo de requisições por minuto, por IP, em /login e /callback (teste negativo 15)
RATE_LIMIT_PER_MINUTE=10

# Modo demonstração: habilita os testes negativos 9, 10 e 11 contra o Google ao vivo.
# Mantenha false fora da apresentação.
DEMO_MODE=false

# Servidor HTTPS local
HOST=localhost
PORT=8443
TLS_CERT_FILE=certs/localhost.crt
TLS_KEY_FILE=certs/localhost.key
DATABASE_PATH=app.db
